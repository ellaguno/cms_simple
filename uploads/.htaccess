# Las imágenes subidas se sirven, pero nunca se ejecuta código aquí
<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
Options -ExecCGI -Indexes
